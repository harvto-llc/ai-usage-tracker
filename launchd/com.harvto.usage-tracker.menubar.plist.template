<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.harvto.usage-tracker.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/UsageMenuBar/.build/release/UsageMenuBar</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/.usage-tracker/logs/menubar.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.usage-tracker/logs/menubar.err.log</string>
</dict>
</plist>
